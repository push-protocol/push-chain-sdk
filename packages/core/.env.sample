# ENV files is required to run test cases
#
# The curated CI suite (.github/workflows/e2e.yml) reads the same variables. To run
# it locally, from packages/core:
#
#   yarn e2e:list      --group all      # what would run, and the jest argv
#   yarn e2e:verify    --group all      # offline: every scenario still matches a test
#   yarn e2e:preflight --group all --dry-run   # balances only, funds nothing
#   yarn e2e:preflight --group all      # tops the UEA / SVM CEA PDA up to target
#   yarn e2e:ci        --group smoke    # run it (smoke moves no funds)
#
# Scenario selection and per-scenario funding live in __e2e__/ci/suite.ts.

## EVM  and Solana- Make sure this pk has funds on the selected network - otherwise some tests would be skipped
EVM_PRIVATE_KEY=YOUR_EVM_PRIVATE_KEY
EVM_RPC=YOUR_EVM_RPC
SOLANA_RPC_URL=YOUR_SOLANA_RPC
SOLANA_PRIVATE_KEY=YOUR_SOLANA_PRIVATE_KEY
## Address that has balance on Push Chain
PUSH_PRIVATE_KEY=YOUR_PUSH_PRIVATE_KEY

## Optional per-chain RPC overrides. Fall back to the SDK's built-in endpoints.
ARBITRUM_SEPOLIA_RPC=
BASE_SEPOLIA_RPC=
BNB_TESTNET_RPC=

## Restrict the chain-fixture suites to a subset. Comma-separated labels, e.g.
## "BNB Testnet,Ethereum Sepolia". Omit to run every configured chain.
E2E_TARGET_CHAINS=

## ---------------------------------------------------------------------------
## PC20
## ---------------------------------------------------------------------------
## PC20 mappings are dynamic and live on chain — there is no static table, so
## every address comes from here. A suite missing what it needs skips loudly
## rather than passing without asserting anything.
##
##   Read-only (registry lookups)   PC20_PUSH_TOKEN
##   Funds-moving (inbound/export)  PC20_PUSH_TOKEN + EVM_PRIVATE_KEY
##
## Run funds-moving PC20 suites serially — `jest --runInBand`. They broadcast
## real transactions from a single key, so parallel workers race for the nonce.

## Push-native PC20 on Donut (0x…). Required by every PC20 suite.
PC20_PUSH_TOKEN=

## Deployed wrapper on Ethereum Sepolia. Optional — it does not exist until a
## first export creates it. Tests needing it skip individually and say so.
PC20_WRAPPER_SEPOLIA=

## CAIP-2 chain id for export tests. Defaults to Ethereum Sepolia.
PC20_EXPORT_DEST_CHAIN=

## A Push PC20 never exported anywhere, for the first-export prediction path.
PC20_UNDEPLOYED_TOKEN=

## Set to 1 to re-enable tolerance for the chain-side fee-credit bug resolved
## on 2026-07-31. Off by default; only useful if a regression is suspected.
PC20_TOLERATE_FEE_CREDIT=
