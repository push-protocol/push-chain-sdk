{
  "name": "@pushchain/core",
  "version": "6.0.22",
  "homepage": "https://push.org",
  "keywords": [
    "pushchain",
    "push",
    "solana",
    "evm",
    "typescript",
    "universal"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pushchain/push-chain-sdk"
  },
  "authors": [
    "https://github.com/Aman035",
    "https://github.com/strykerin"
  ],
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "^2.0.0",
    "@cosmjs/crypto": "0.33.1",
    "@cosmjs/encoding": "0.33.1",
    "@cosmjs/proto-signing": "^0.33.1",
    "@cosmjs/stargate": "^0.33.1",
    "@cosmjs/tendermint-rpc": "0.33.1",
    "@solana/web3.js": "^1.68.0",
    "bs58": "^4.0.0",
    "buffer": "^6.0.3",
    "cosmjs-types": "0.9.0",
    "tslib": "^2.3.0",
    "viem": "^2.27.2"
  },
  "peerDependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "ethers": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "peerDependenciesMeta": {
    "@coral-xyz/anchor": {
      "optional": true
    },
    "ethers": {
      "optional": true
    },
    "tweetnacl": {
      "optional": true
    }
  },
  "scripts": {
    "build:proto": "scripts/protoc-generate.sh",
    "e2e:list": "ts-node --transpile-only __e2e__/ci/run.ts --list",
    "e2e:verify": "ts-node --transpile-only __e2e__/ci/run.ts --verify",
    "e2e:preflight": "ts-node --transpile-only __e2e__/ci/preflight.ts",
    "e2e:ci": "ts-node --transpile-only __e2e__/ci/run.ts"
  },
  "type": "commonjs",
  "main": "./src/index.js",
  "typings": "./src/index.d.ts",
  "sideEffects": [
    "./src/lib/internal/global-buffer-polyfill.*"
  ],
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/**/*.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/bs58": "^4.0.0",
    "dotenv": "^16.4.5",
    "secp256k1": "^5.0.1",
    "ts-node": "10.9.1",
    "ts-proto": "^2.0.3"
  }
}
